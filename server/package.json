{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc && node scripts/fix-dist-imports.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "prisma migrate deploy",
    "test": "tsx --test tests/**/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:catalogue": "tsx scripts/seed-mock-catalogue.ts",
    "lint": "eslint src/",
    "prisma:generate": "prisma generate",
    "db:ping": "tsx scripts/neon-ping.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^6.30.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.10",
    "eslint": "^9.39.5",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0"
  }
}
