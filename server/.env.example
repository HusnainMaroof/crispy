
# ─── Neon (Prisma) ─────────────────────────────────────
# Pooled connection string from the Neon dashboard. Used by the Express app.
NEON_DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooler) connection string. Used by Prisma migrations.
NEON_DIRECT_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# ─── JWT (admin sessions) ──────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── Server ────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ──────────────────────────────────────────────
# Set your client domain in production (e.g. https://crispies.com)
# Defaults to * for development if not set.
CORS_ORIGIN=https://crispies.com

# ─── Rate Limiting ────────────────────────────────────
RATE_LIMIT_MAX=100

# ─── Cloudinary (image uploads) ────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Resend (transactional emails) ──────────────────────
# API key: https://resend.com/api-keys  (re_send_...)
RESEND_API_KEY=re_your-resend-api-key
# Must be a sender you have verified in Resend. Until a domain is verified,
# Resend only allows "onboarding@resend.dev" and only to your own address.
EMAIL_FROM=onboarding@resend.dev
ADMIN_EMAIL=admin@crispies.com

# ─── Franchise ─────────────────────────────────────────
# Absolute https URL of the brochure PDF emailed to visitors.
FRANCHISE_BROCHURE_URL=https://crispies.co.uk/brochure.pdf
PUBLIC_SITE_URL=https://crispies.co.uk

# ─── Super admin bootstrap (scripts/reset-superadmin) ───
# Read only by `pnpm tsx scripts/reset-superadmin.ts`. Not used by the running
# server. Creates or re-passwords the single account below and leaves every
# other admin alone. Add --purge to wipe all admins first.
SUPERADMIN_EMAIL=superadmin@crispies.com
SUPERADMIN_PASSWORD=change-me

# ─── Logging ───────────────────────────────────────────
LOG_LEVEL=info

SLOW_QUERY_MS=0

# ─── Location search (branch finder) ───────────────────
# Straight-line search radius in miles, 1 to 200. Default 50.
LOCATION_RADIUS_MILES=50
# Timeout for each geocoder request, in ms. Default 5000.
LOCATION_GEOCODE_TIMEOUT_MS=5000
# Nominatim (OpenStreetMap) is used for street addresses only. Set false to turn it off.
# Its usage policy forbids heavy or unidentified traffic, so do not rely on it for high volume.
LOCATION_NOMINATIM_ENABLED=true
LOCATION_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Identifies this site to Nominatim. Put a real contact URL or email here.
LOCATION_USER_AGENT=CrispiesBranchLocator/1.0 (https://crispies.co.uk)

# ─── Road routing (route preview on the branch map) ────
# Base URL of an OSRM-compatible routing server, with no trailing slash.
# Leave EMPTY to turn in-app routes off. The site then shows an external
# navigation link instead. Do not point this at the public OSRM demo server
# for production traffic, its usage policy forbids it.
ROUTING_OSRM_URL=
# Profile name on that server. "driving" is the common default, some builds use "car".
ROUTING_OSRM_PROFILE=driving
ROUTING_TIMEOUT_MS=6000

