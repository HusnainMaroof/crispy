generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model menu_categories {
  id         String       @id
  number     String
  title      String
  title_ar   String       @default("")
  image      String       @default("")
  sort_order Int          @default(0)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  menu_items menu_items[]
}

model menu_items {
  id            String           @id
  category_id   String
  category      menu_categories @relation(fields: [category_id], references: [id], onDelete: Cascade)
  name          String
  name_ar       String           @default("")
  description   String           @default("")
  description_ar String          @default("")
  // One redirect link per delivery platform. The Get It Delivered popup uses
  // the link for whichever platform the customer picked. Empty means fall back
  // to that platform's site-wide link.
  redirect_uber_eats  String        @default("")
  redirect_deliveroo  String        @default("")
  redirect_just_eat   String        @default("")
  price         Decimal          @db.Decimal(10, 2)
  image         String           @default("")
  badge         String?
  badge_variant String?
  sort_order    Int              @default(0)
  active        Boolean          @default(true)
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  order_items        order_items[]
  branch_menu_items  branch_menu_items[]

  /// getFullMenu reads items per category with active = true ordered by sort_order.
  @@index([category_id, active, sort_order])
}

model deals {
  id            String   @id
  name          String
  name_ar       String   @default("")
  description   String   @default("")
  description_ar String @default("")
  price         Decimal  @db.Decimal(10, 2)
  image         String   @default("")
  badge         String?
  badge_variant String?
  active        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  branch_deals  branch_deals[]
  order_items   order_items[]

  @@index([active])
}

model locations {
  id                       String                @id
  name                     String
  slug                     String?               @unique
  address                  String
  postcode                 String?
  city                     String?
  hours                    String
  phone                    String
  lat                      Decimal?              @db.Decimal(10, 7)
  lng                      Decimal?              @db.Decimal(10, 7)
  status                   String                @default("active")
  delivery_enabled         Boolean               @default(true)
  collection_enabled       Boolean               @default(true)
  delivery_fee             Decimal?              @db.Decimal(10, 2)
  free_delivery_threshold  Decimal?              @db.Decimal(10, 2)
  sort_order               Int                   @default(0)
  created_at               DateTime              @default(now())
  updated_at               DateTime              @updatedAt
  orders                   orders[]
  branch_menu_items        branch_menu_items[]
  branch_deals             branch_deals[]
  admin_branch_access      admin_branch_access[]
  job_posts                job_posts[]
}

model orders {
  id             BigInt        @id @default(autoincrement())
  customer_name  String
  email          String
  phone          String
  address        String?
  postcode       String?
  city           String?
  notes          String?
  fulfilment     String        @default("delivery")
  payment_method String        @default("card")
  subtotal       Decimal       @db.Decimal(10, 2)
  delivery_fee   Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  status         String        @default("pending")
  location_id    String?
  location       locations?    @relation(fields: [location_id], references: [id], onDelete: SetNull)
  customer_id    String?
  customer       customers?    @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  checkout_key   String?       @unique
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  order_items    order_items[]

  @@index([status, location_id])
  @@index([created_at])
  // customer_id alone is not indexed separately. (customer_id, created_at)
  // leads with customer_id, so customer-history lookups use that index.
  // Filtering by branch or customer and ordering by date is the shape of every
  // paginated order list. With only (status, location_id) and a bare
  // (created_at), Postgres walks the date index backwards and filters, which
  // degrades to a near-full scan once the table grows.
  @@index([location_id, created_at])
  @@index([status, created_at])
  @@index([customer_id, created_at])
}

model order_items {
  id           BigInt      @id @default(autoincrement())
  order_id     BigInt
  order        orders      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  menu_item_id String?
  menu_item    menu_items? @relation(fields: [menu_item_id], references: [id], onDelete: SetNull)
  deal_id      String?
  deal         deals?      @relation(fields: [deal_id], references: [id], onDelete: SetNull)
  kind         String      @default("product")
  name         String
  price        Decimal     @db.Decimal(10, 2)
  quantity     Int
  created_at   DateTime    @default(now())

  @@index([order_id])
  // Postgres has no index for this foreign key, so deleting a menu item
  // seq-scans the whole order_items table to find the rows to detach.
  @@index([menu_item_id])
}

model customers {
  id         String   @id
  name       String?
  email      String?
  phone      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  orders     orders[]

  // The customer list pages on created_at DESC, id DESC. Without this the sort
  // has no index to read from at all.
  @@index([created_at, id])
}

model business_settings {
  id                      BigInt   @id @default(autoincrement())
  delivery_fee            Decimal  @default(2.99) @db.Decimal(10, 2)
  free_delivery_threshold Decimal  @default(20.00) @db.Decimal(10, 2)
  updated_at              DateTime @updatedAt
}

model job_posts {
  id            String             @id
  title         String
  /// Arabic display copy, same convention as `menu_items.name_ar`: shown in
  /// the Arabic store when set, English otherwise. Edited in the job form.
  title_ar        String             @default("")
  /// Branch label, copied from `locations.name` on every write so the public
  /// careers list can render it without a join. `location_id` is the relation
  /// that filtering and permission checks use; this column is display only.
  location      String
  location_id   String?
  location_ref  locations?         @relation(fields: [location_id], references: [id], onDelete: SetNull)
  type          String
  salary        String
  description   String
  description_ar String            @default("")
  requirements  Json               @default("[]")
  requirements_ar Json             @default("[]")
  status        String             @default("draft")
  applications  Int                @default(0)
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt
  job_applications job_applications[]

  @@index([status])
  /// The create form offers every type already in use, so this is read often.
  @@index([type])
  /// Branch-scoped lists always sort by date, so the branch leads the index.
  @@index([location_id, created_at])
  /// Branch-scoped lists filtered by status, e.g. ?status=active.
  @@index([location_id, status])
}

model job_applications {
  id             String    @id
  job_post_id    String
  job_post       job_posts @relation(fields: [job_post_id], references: [id], onDelete: Cascade)
  applicant_name String
  email          String
  phone          String?
  cv_url         String?
  cover_letter   String?
  status         String    @default("pending")
  notes          String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([job_post_id])
  @@index([status])
  /// The applications grid filters by post and status together.
  @@index([job_post_id, status])
}

model contact_messages {
  id         BigInt   @id @default(autoincrement())
  name       String
  email      String
  subject    String
  message    String
  type       String   @default("general")
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([read])
}

model admin_profiles {
  id                  String                @id @default(uuid())
  email               String                @unique
  name                String
  /// superadmin | branch_manager | staff
  role                String                @default("staff")
  position            String?
  tabs                String[]              @default([])
  password_hash       String
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  admin_branch_access admin_branch_access[]
}

model branch_menu_items {
  id           BigInt    @id @default(autoincrement())
  location_id  String
  location     locations @relation(fields: [location_id], references: [id], onDelete: Cascade)
  menu_item_id String
  menu_item    menu_items @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)
  price        Decimal?  @db.Decimal(10, 2)
  available    Boolean   @default(true)
  sort_order   Int?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@unique([location_id, menu_item_id])
  @@index([location_id, available])
}

model branch_deals {
  id          BigInt    @id @default(autoincrement())
  location_id String
  location    locations @relation(fields: [location_id], references: [id], onDelete: Cascade)
  deal_id     String
  deal        deals     @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  price       Decimal?  @db.Decimal(10, 2)
  available   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@unique([location_id, deal_id])
  /// getDeals filters location_id + available, matching branch_menu_items.
  @@index([location_id, available])
}

model admin_branch_access {
  admin_id    String
  admin       admin_profiles @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  location_id String
  location    locations      @relation(fields: [location_id], references: [id], onDelete: Cascade)
  created_at  DateTime       @default(now())

  @@id([admin_id, location_id])
  // The primary key leads with admin_id, so grouping by location for the
  // branch staff-count has to sort the whole table on every locations request.
  @@index([location_id])
}

model homepage_content {
  key        String   @id
  content    Json     @default("{}")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model cms_sections {
  id           String   @id @default(uuid())
  page         String
  key          String
  sort_order   Int      @default(0)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  translations cms_section_translations[]

  @@unique([page, key])
  @@index([page, is_active, sort_order])
}

model cms_section_translations {
  id           String       @id @default(uuid())
  section_id   String
  section      cms_sections @relation(fields: [section_id], references: [id], onDelete: Cascade)
  locale       String
  content      Json         @default("{}")
  is_published Boolean      @default(false)
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  @@unique([section_id, locale])
}
